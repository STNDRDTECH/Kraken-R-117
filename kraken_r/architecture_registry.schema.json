{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kraken-R architecture registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_kind", "registry_id", "version", "authority_boundary", "mechanisms"],
  "properties": {
    "registry_kind": {"const": "kraken_r_architecture"},
    "registry_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "last_reviewed": {"type": "string"},
    "authority_boundary": {
      "type": "object",
      "required": ["legacy_reference", "kraken_candidate", "preservation"],
      "additionalProperties": false,
      "properties": {
        "legacy_reference": {"type": "string", "minLength": 1},
        "kraken_candidate": {"type": "string", "minLength": 1},
        "preservation": {"type": "string", "minLength": 1}
      }
    },
    "mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "mechanism_id", "category", "name", "intended_role", "current_status",
          "dependencies", "authority", "evidence_grade", "evidence_refs",
          "duplicates", "disposition", "source_refs", "planned", "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "mechanism_id": {"type": "string", "minLength": 1},
          "category": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "intended_role": {"type": "string", "minLength": 1},
          "current_status": {
            "enum": ["active", "partial", "dormant", "design_only", "alternate", "duplicate", "missing", "experimental", "infrastructure"]
          },
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "authority": {
            "enum": ["legacy_reference", "kraken_candidate", "domain_adapter", "documentation_only", "none"]
          },
          "evidence_grade": {"type": "string", "minLength": 1},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "duplicates": {"type": "array", "items": {"type": "string"}},
          "disposition": {
            "enum": ["keep", "merge", "quarantine", "rebuild", "leave_experimental"]
          },
          "source_refs": {"type": "array", "items": {"type": "string"}},
          "planned": {"type": "boolean"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}